<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Big Toggle Button -->
    <ImageView
        android:id="@+id/ivWidgetToggle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_power_button_off"
        android:padding="10dp"
        android:src="@drawable/ic_power" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvWidgetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvWidgetStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/status_unprotected"
            android:textColor="@color/neon_red"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvWidgetMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mode_standard_title"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
